NODE_ENV=development
PORT=port_number_here

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public"

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN="7d"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend URL (for frontend API calls)
BACKEND_URL=http://localhost:port_number_here

# SMTP — Nodemailer (Gmail : activer "Mots de passe d'application" dans le compte Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_app_password_here
CONTACT_EMAIL_TO=your_gmail_address@gmail.com